# Supabase project URL and new API keys.
# Preview/staging should use sb_publishable/sb_secret keys, not legacy JWT keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret API key used by audited write/moderation RPCs.
# New sb_secret keys must be sent only as apikey, never as Authorization Bearer.
SUPABASE_SECRET_KEY=

# Legacy fallback names retained for local compatibility only. Do not use them for preview/staging.
SUPABASE_ANON_KEY=
# Never send this in chat, expose it to the browser, or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Atomic backend selector. `postgres` switches both DataTransport and opaque
# sessions together; do not deploy a mixed provider configuration.
CHACHA_BACKEND_PROVIDER=supabase

# Server-only standard PostgreSQL connection string. For Tencent Cloud use a
# dedicated least-privilege login and verified TLS, for example sslmode=verify-full.
DATABASE_URL=

# Server-only secret for 5-second read completion tokens.
# Use at least 32 random characters and never commit the real value.
CHACHA_READ_TOKEN_SECRET=

# Server-only HMAC secret for 15-minute anonymous zone-presence proofs.
# Use a different value from CHACHA_READ_TOKEN_SECRET.
CHACHA_PRESENCE_TOKEN_SECRET=

# Server-only HMAC secret for fuzzy nearby-life-circle cell ids.
# Use a different value from the read and presence token secrets.
CHACHA_LOCATION_HMAC_SECRET=

# Public-id/password authentication rollout. Keep the gate disabled until the
# migration, recovery flow and CAPTCHA have all been verified in staging.
AUTH_GATE_ENABLED=false

# Server-only HMAC secret for recovery-code hashes and rate-limit digests.
# Use at least 32 random characters and keep it distinct from other secrets.
CHACHA_AUTH_HMAC_SECRET=

# Require a verified CAPTCHA token on registration, login and recovery.
CHACHA_CAPTCHA_REQUIRED=false

# Cloudflare Turnstile keys. The site key is public; the secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public compliance information shown in the global footer and legal pages.
# Use the exact strings approved by the filing authorities.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_COMPLIANCE_CONTACT=
NEXT_PUBLIC_ICP_FILING_NUMBER=
NEXT_PUBLIC_PUBLIC_SECURITY_FILING_NUMBER=

# Supabase Send SMS Hook -> Tencent Cloud SMS. All values below are
# server-only and must never be exposed with a NEXT_PUBLIC_ prefix.
# Supabase generates the hook secret when the HTTP hook is configured.
SUPABASE_SEND_SMS_HOOK_SECRET=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# Tencent Cloud SMS accepts this region for the SendSms API.
TENCENT_SMS_REGION=ap-guangzhou

# Server-only comma-separated public IDs allowed to open the read-only steward
# dashboard. Access still requires the matching active, permanent session.
CHACHA_ADMIN_PUBLIC_IDS=
