# Supabase project URL and anonymous browser-safe key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only key used by audited comment/moderation RPCs. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret. Use at least 32 random characters and never commit the real value.
CHACHA_READ_TOKEN_SECRET=

# Server-only HMAC secret for 15-minute anonymous zone-presence proofs.
CHACHA_PRESENCE_TOKEN_SECRET=
