# Supabase project URL and new API keys.
# Preview/staging should use sb_publishable/sb_secret keys, not legacy JWT keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret API key used by audited write/moderation RPCs.
# New sb_secret keys must be sent only as apikey, never as Authorization Bearer.
SUPABASE_SECRET_KEY=

# Legacy fallback names retained for local compatibility only. Do not use them for preview/staging.
SUPABASE_ANON_KEY=
# Never send this in chat, expose it to the browser, or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret for 5-second read completion tokens.
# Use at least 32 random characters and never commit the real value.
CHACHA_READ_TOKEN_SECRET=

# Server-only HMAC secret for 15-minute anonymous zone-presence proofs.
# Use a different value from CHACHA_READ_TOKEN_SECRET.
CHACHA_PRESENCE_TOKEN_SECRET=

# Server-only HMAC secret for fuzzy nearby-life-circle cell ids.
# Use a different value from the read and presence token secrets.
CHACHA_LOCATION_HMAC_SECRET=

# Phone authentication rollout. Keep the gate disabled until the Supabase
# migration, SMS Hook and CAPTCHA have all been verified in staging.
AUTH_GATE_ENABLED=false

# Server-only HMAC secret for phone-auth challenges and rate-limit digests.
# Use at least 32 random characters and keep it distinct from other secrets.
CHACHA_AUTH_HMAC_SECRET=

# Require a CAPTCHA token before sending an SMS in public environments.
CHACHA_CAPTCHA_REQUIRED=false

# Public Cloudflare Turnstile site key. This is safe to expose in the browser;
# the corresponding secret key is configured in Supabase, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
