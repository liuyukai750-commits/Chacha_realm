[Unit]
Description=Chacha Street Next.js service
Documentation=https://example.invalid
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chacha
Group=chacha
WorkingDirectory=/srv/chacha-street/current
EnvironmentFile=/etc/chacha-street/chacha-street.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NODE_OPTIONS=--max-old-space-size=1024
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chacha-street

# 2C2G guardrails: leave memory for nginx, journald and the operating system.
MemoryHigh=1200M
MemoryMax=1500M
TasksMax=256

# Basic systemd hardening. Runtime cache is symlinked into shared/cache.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/chacha-street/shared

[Install]
WantedBy=multi-user.target
