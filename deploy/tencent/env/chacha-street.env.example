# Copy to /etc/chacha-street/chacha-street.env on the server, set mode 0600,
# and replace every REPLACE_* value. Never commit the populated file.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
NODE_OPTIONS=--max-old-space-size=1024

# Atomic backend switch. Keep `supabase` during transitional deployment. Set
# `postgres` only after database + local Session rehearsal passes; it switches
# both data transport and sessions together.
CHACHA_BACKEND_PROVIDER=supabase

# Required only when CHACHA_BACKEND_PROVIDER=postgres. Use a dedicated runtime
# login granted the chacha_app role and verified TLS (sslmode=verify-full).
DATABASE_URL=
# CA bundle used by Node.js to verify the TencentDB server certificate.
NODE_EXTRA_CA_CERTS=/etc/chacha-street/tencent-postgres-ca.pem

# Set NEXT_PUBLIC_* before `next build`; Next.js embeds them in the browser
# bundle. Keep the same values here so runtime diagnostics are unambiguous.
NEXT_PUBLIC_SITE_URL=https://example.invalid
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_COMPLIANCE_CONTACT=
NEXT_PUBLIC_ICP_FILING_NUMBER=
NEXT_PUBLIC_PUBLIC_SECURITY_FILING_NUMBER=

# Transitional Supabase backend. Required only while the selector is supabase;
# remove after the separately verified PostgreSQL/account cutover.
SUPABASE_URL=REPLACE_WITH_SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=REPLACE_WITH_SUPABASE_SECRET_KEY

# Independent server-only secrets (minimum 32 random characters each).
CHACHA_READ_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET
CHACHA_PRESENCE_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
CHACHA_LOCATION_HMAC_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
CHACHA_AUTH_HMAC_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET

# Public-id/password login rollout. Enable only after the matching migration
# and recovery flow have passed staging verification.
AUTH_GATE_ENABLED=false
CHACHA_CAPTCHA_REQUIRED=false
TURNSTILE_SECRET_KEY=

# Comma-separated public IDs that may open the read-only operator dashboard.
CHACHA_ADMIN_PUBLIC_IDS=

# Optional legacy phone/SMS integration. Leave empty when public-id/password
# login is used. These values are server-only.
SUPABASE_SEND_SMS_HOOK_SECRET=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
