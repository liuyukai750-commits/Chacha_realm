{
  "name": "chacha_street",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "qa:contracts": "node --test tests/unified-burial-reward-contract.test.mjs tests/ambient-audio-contract.test.mjs tests/bury-entry-consistency.test.mjs tests/five-city-gate.test.mjs tests/mobile-reader-contract.test.mjs",
    "qa:db": "node scripts/check-supabase-migrations.mjs",
    "qa:mobile": "npx playwright test --config tests/e2e/mobile-reader.config.mjs",
    "qa:smoke": "npm run qa:contracts && npm run qa:db && npm run lint -- src/components/ambient-audio src/components/chacha-island.tsx src/components/bury-sheet-v1.tsx src/server/repositories/island-repository.ts && npx tsc --noEmit && npx playwright test --config tests/e2e/release-smoke.config.mjs && npm run qa:mobile",
    "preview:setup": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "standardwebhooks": "1.0.0",
    "tencentcloud-sdk-nodejs-sms": "4.1.240"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "tencentcloud-sdk-nodejs-common": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
